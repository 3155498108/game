<view class="page home">
  <view class="head">
    <view class="head-l">
      <text class="title">小游戏合集</text>
      <text class="sub">{{total}} 款</text>
    </view>
    <view class="head-r">
      <view class="wallet">🪙 {{wallet}}</view>
      <view wx:if="{{canSignin}}" class="signin" bindtap="onSignin">签到 +{{signinAmount}}</view>
      <view wx:else class="signin done">已签到</view>
    </view>
  </view>

  <view class="daily" bindtap="onDaily">
    <view class="daily-l">
      <text class="daily-t">今日挑战</text>
      <text class="daily-s">{{today}}</text>
    </view>
    <text class="daily-n">{{dailyName}} ›</text>
  </view>

  <input class="search" placeholder="搜索游戏名或玩法" value="{{q}}" bindinput="onSearch" confirm-type="search" />

  <scroll-view class="chips" scroll-x enable-flex>
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="chip {{cat === item.key ? 'on' : ''}}"
      data-k="{{item.key}}"
      bindtap="onCat"
    >{{item.label}}</view>
  </scroll-view>

  <scroll-view class="list" scroll-y>
    <!-- 按分类分组：标题是该分类名 + 该分类下的游戏数 -->
    <view wx:for="{{groups}}" wx:key="key" class="group">
      <view class="group-h">
        <text class="group-t">{{item.label}}</text>
        <text class="group-n">{{item.items.length}}</text>
      </view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="g"
        wx:key="id"
        class="card"
        data-id="{{g.id}}"
        bindtap="onPlay"
      >
        <view class="card-l">
          <text class="card-t">{{g.name}}</text>
          <text class="card-s">{{g.summary}}</text>
          <view class="tags">
            <text wx:for="{{g.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text>
          </view>
          <view class="tags meta">
            <text class="tag">{{g.playersLabel}}</text>
            <text wx:if="{{g.landscape}}" class="tag orient">横屏</text>
            <text wx:if="{{g.best}}" class="tag best">{{g.best}}</text>
          </view>
        </view>
        <view class="card-r" data-id="{{g.id}}" catchtap="onHowto">玩法</view>
      </view>
    </view>
    <view wx:if="{{groups.length === 0}}" class="empty">没有匹配的游戏</view>
    <view class="pad"></view>
  </scroll-view>

  <view wx:if="{{howtoOpen}}" class="mask" bindtap="onCloseHowto">
    <view class="sheet" catchtap="onNoop">
      <text class="sheet-t">{{howtoTitle}} · 玩法</text>
      <scroll-view class="sheet-b" scroll-y>
        <view wx:for="{{howto}}" wx:key="*this" class="sheet-i">{{index + 1}}. {{item}}</view>
      </scroll-view>
      <view class="btn primary sheet-x" bindtap="onCloseHowto">知道了</view>
    </view>
  </view>

  <view wx:if="{{!toastHidden}}" class="toast" bindtap="onToastOk">{{toast}}</view>
</view>
